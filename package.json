{
  "name": "table-soccer-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "4-player online foosball with server-authoritative physics, Elo ratings and tournaments",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "seed": "tsx seed.ts",
    "seed:reset": "tsx seed.ts --reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx e2e.mjs",
    "test:practice": "tsx practice-test.mjs",
    "test:ui": "node journey.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^5.3.0",
    "framer-motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
